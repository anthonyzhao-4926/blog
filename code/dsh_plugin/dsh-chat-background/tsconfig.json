{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "es2022",
        "lib": [
            "es2022",
            "dom"
        ],
        "types": [
            "node"
        ],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": [
        "src/*.ts"
    ]
}
# macOS 本地状态文件
.DS_Store
._*
.Spotlight-V100
.Trashes

# Obsidian 配置（各设备独立维护，不共享）
.obsidian/
.claude/

# Obsidian 回收站（删除的笔记/图片，不应入库）
.trash/
local/

# Node 依赖与包管理器缓存（体积大、可重装，不入库）
node_modules/
.pnpm-store/
.npm/
.yarn/

# 构建产物（由源码生成，不入库）
dist/
*.tsbuildinfo

# 包管理器调试日志
pnpm-debug.log*
npm-debug.log*
yarn-error.log*

